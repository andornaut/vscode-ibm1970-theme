{
  "name": "ibm1970",
  "displayName": "IBM 1970s dark color theme",
  "description": "An IBM and 1970s inspired dark color theme",
  "homepage": "https://github.com/andornaut/vscode-ibm1970-theme",
  "icon": "icon.png",
  "license": "MIT",
  "private": true,
  "publisher": "Andornaut",
  "version": "0.3.7",
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "id": "IBM 1970 Dark",
        "label": "IBM 1970",
        "uiTheme": "vs-dark",
        "path": "./themes/ibm1970-dark-color-theme.json"
      }
    ]
  },
  "engines": {
    "node": ">=24.19.0",
    "vscode": "^1.57.0"
  },
  "galleryBanner": {
    "color": "#24201A",
    "theme": "dark"
  },
  "keywords": [
    "1970",
    "brown",
    "dark",
    "green",
    "ibm",
    "solarized dark",
    "solarized",
    "teal"
  ],
  "bugs": {
    "url": "https://github.com/andornaut/vscode-ibm1970-theme/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andornaut/vscode-ibm1970-theme"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "package": "mkdir -p dist && vsce package --out dist/",
    "prepare": "husky",
    "swatches": "rm -rf swatches && mkdir swatches && color-swatches --format png swatches themes/*.json"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "color-swatches": "github:andornaut/color-swatches-action#v1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
